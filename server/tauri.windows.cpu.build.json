{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "xqlink",
    "version": "0.1.2",
    "identifier": "top.itmeng.xqlink",
    "build": {
        "beforeBuildCommand": null,
        "frontendDist": "../dist",
        "removeUnusedCommands": true
    },
    "app": {
        "windows": [
            {
                "title": "中国象棋",
                "width": 660,
                "height": 580,
                "minWidth": 380,
                "minHeight": 340,
                "resizable": true,
                "hiddenTitle": true,
                "fullscreen": false,
                "maximizable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "msi",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "allowDowngrades": true,
            "certificateThumbprint": null,
            "digestAlgorithm": null,
            "nsis": null,
            "signCommand": null,
            "timestampUrl": null,
            "tsp": false,
            "webviewInstallMode": {
                "silent": true,
                "type": "downloadBootstrapper"
            },
            "wix": {
                "language": "zh-CN"
            }
        },
        "resources": {
            "../libs/windows-cpu/*.dll": "./",
            "../libs/pikafish/pikafish-windows.exe": "../libs/pikafish/pikafish-windows.exe",
            "../libs/pikafish/pikafish.nnue": "../libs/pikafish/pikafish.nnue"
        }
    }
}
